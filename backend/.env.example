# ============================================================
# Distributed Task Queue — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Redis (Upstash) ---
# Get these from: https://console.upstash.com → Your Database → Details
REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_ENDPOINT.upstash.io:6379

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Worker Configuration ---
# How often the worker polls Redis for new jobs (milliseconds)
WORKER_POLL_INTERVAL_MS=1000

# Maximum retry attempts before sending to DLQ
MAX_RETRIES=3

# --- CORS ---
# Frontend URL for CORS whitelist (comma-separated for multiple)
FRONTEND_URL=http://localhost:5500
